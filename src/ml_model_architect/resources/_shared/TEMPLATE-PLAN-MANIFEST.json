{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "plan_version": "1.0.0",
  "project_id": "<project-id>",
  "generated_at": "<ISO-8601-date>",
  "status": "LOCKED",
  "client_grounding": {
    "task_type": "<binary_classification | multi_class | regression | anomaly | time_series>",
    "target_column": "<target_name>",
    "business_metric": "<e.g., PR-AUC, F1, RMSE>",
    "cost_priority": "<high_precision | high_recall | balanced | interpretability_first>",
    "max_allowed_latency_ms": 50,
    "hardware_constraints": "<e.g., CPU-only, memory < 4GB>"
  },
  "execution_dag": [
    {
      "step_id": "STEP_01_PIPELINE_SPECIFICATION",
      "stage": 3,
      "description": "Construct single scikit-learn Pipeline with zero data leakage.",
      "reference_anchor": "<DOI or trusted paper anchor>",
      "allowed_context": [
        "REQUIREMENTS.md",
        "TECH-CHOICE.md",
        "references/stage-3-training/training-<group_id>.md"
      ],
      "pre_conditions": [
        "file_exists('REQUIREMENTS.md')",
        "file_exists('TECH-CHOICE.md')"
      ],
      "action_type": "GENERATE_CODE",
      "target_file": "sandbox/pipeline.py",
      "post_assertions": [
        "file_exists('sandbox/pipeline.py')",
        "ast_scanner_passed('sandbox/pipeline.py')",
        "is_single_sklearn_pipeline('sandbox/pipeline.py')"
      ]
    },
    {
      "step_id": "STEP_02_BASELINE_EXPERIMENT",
      "stage": 3,
      "description": "Train and evaluate baseline model with 5-fold stratified cross-validation.",
      "reference_anchor": "<Foundational baseline citation>",
      "allowed_context": [
        "TECH-CHOICE.md"
      ],
      "pre_conditions": [
        "file_exists('sandbox/pipeline.py')"
      ],
      "action_type": "RUN_EXPERIMENT",
      "target_file": "sandbox/train_baseline.py",
      "post_assertions": [
        "file_exists('sandbox/train_baseline.py')",
        "ast_scanner_passed('sandbox/train_baseline.py')",
        "cv_folds_logged(5)"
      ]
    },
    {
      "step_id": "STEP_03_CANDIDATE_MODEL_AND_1SE_RULE",
      "stage": 4,
      "description": "Empirical comparison of candidate model against baseline using 1-SE rule.",
      "reference_anchor": "10.1007/978-0-387-84858-7",
      "allowed_context": [
        "references/stage-4-evaluation/eval-01-metrics.md"
      ],
      "pre_conditions": [
        "file_exists('sandbox/train_baseline.py')"
      ],
      "action_type": "EVALUATE_AND_DECIDE",
      "target_file": "EVALUATION-REPORT.md",
      "post_assertions": [
        "file_exists('EVALUATION-REPORT.md')",
        "assert_1se_rule_applied()",
        "decision_logged_in_ledger('DECISIONS.md')"
      ]
    }
  ]
}
